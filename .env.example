# =============================================================================
# Supabase (required)
# Copy to .env.local and fill in your own values. Never commit .env.local.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Keep this off the client.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# AI router — free-only by default
# =============================================================================
# AI_FREE_ONLY=1 blocks paid providers and paid model overrides at runtime.
# Leave this at 1 unless you intentionally want to spend paid credits.
AI_FREE_ONLY=1
AI_PROVIDER_ORDER=opencode,google,groq,openrouter

# Global and per-agent fallbacks (used when an agent has no explicit budget).
AI_DAILY_TOKEN_LIMIT=100000
AI_AGENT_DAILY_TOKEN_LIMIT=15000
AI_TASK_TOKEN_LIMIT=15000

# Hard ceiling for one model call and manager revision rounds.
AI_MAX_TOKENS_PER_CALL=3000
AI_MAX_REVIEW_ROUNDS=1

# =============================================================================
# OpenCode Zen — free models only
# =============================================================================
# The key is used for authentication. AI_FREE_ONLY=1 rejects the paid Go
# endpoint and any model that is not in the free model catalog.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4.1-flash-free

# =============================================================================
# Free fallback providers
# =============================================================================

# Google AI Studio (Gemini free tier)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# Groq free tier
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter free models. Keep a :free model or the free router.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# =============================================================================
# Paid providers — blocked while AI_FREE_ONLY=1
# =============================================================================
# Leave these empty unless you deliberately turn off the free-only guard.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# =============================================================================
# Public URL and OAuth channels
# =============================================================================

APP_BASE_URL=http://localhost:3000

# Google Cloud > APIs & Services > Credentials > OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok for Developers > Login Kit / Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Encrypt channel tokens at rest: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# =============================================================================
# Mac autopilot (optional)
# =============================================================================
# Use a dedicated test account. The autopilot is opt-in and is not started by
# `npm run dev`; it drives the company page with Playwright.

AUTOPILOT_EMAIL=
AUTOPILOT_PASSWORD=
AUTOPILOT_COMPANY_IDS=
AUTOPILOT_CHECK_MS=180000
