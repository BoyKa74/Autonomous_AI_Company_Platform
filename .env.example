# ===== Supabase (bắt buộc) =====
# Lấy trong Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== AI providers (cần ít nhất 1 key) =====
# Router sẽ tự dùng provider nào có key, theo thứ tự AI_PROVIDER_ORDER

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# GOOGLE_API_KEY hoặc GEMINI_API_KEY đều được
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Thứ tự fallback mặc định (tuỳ chọn)
AI_PROVIDER_ORDER=openai,anthropic,google,openrouter
