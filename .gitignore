# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!services/windows/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media stack (engine tải về máy, secrets, build local)
services/engines/
services/**/.env
services/worker/node_modules/
services/windows/*.cmd.local

# Third-party Agent skills installed by `npx skills` (reinstall via README)
.agents/
