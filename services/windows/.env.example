# ============================================================
# VIC Media Worker — biến môi trường (copy thành .env)
# Chạy trên máy Windows. KHÔNG commit file .env.
# ============================================================

SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key: Supabase Dashboard > Project Settings > API > service_role
# CẢNH BÁO: key này bỏ qua RLS — chỉ để trên máy chủ, không chia sẻ.
SUPABASE_SERVICE_ROLE_KEY=

# Engine local
ACESTEP_URL=http://127.0.0.1:8085
VIENEU_URL=http://127.0.0.1:8000
VIENEU_MODEL=vieneu-v3-turbo

# Tuỳ chọn
MEDIA_BUCKET=media
POLL_MS=3000
MUSIC_TIMEOUT_MS=2700000
VOICE_TIMEOUT_MS=900000
STALE_JOB_HOURS=2
